# ─── Public ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (Neon) ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/flux?sslmode=require"

# ─── Auth (better-auth) ──────────────────────────────────
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (Vercel AI Gateway / Anthropic) ──────────────────
ANTHROPIC_API_KEY=""
AI_GATEWAY_URL=""           # optional, e.g. https://gateway.ai.cloudflare.com/v1/...
AI_MODEL_PRIMARY="claude-sonnet-4-6"
AI_MODEL_FAST="claude-haiku-4-5-20251001"

# ─── Redis (Upstash) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Cloudinary (optional — for export uploads) ──────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Observability ───────────────────────────────────────
LOG_LEVEL="info"
