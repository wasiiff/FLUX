# ─── Public ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (Neon) ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/flux?sslmode=require"

# ─── Auth (better-auth) ──────────────────────────────────
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI · Vercel AI Gateway ──────────────────────────────
# One key, hundreds of models. https://vercel.com/docs/ai-gateway
# When deployed to Vercel with AI Gateway enabled, this is auto-injected via OIDC.
AI_GATEWAY_API_KEY=""

# Models are addressed as "provider/model-id". Swap freely without code changes.
# Browse the catalog: https://vercel.com/ai-gateway/models
AI_MODEL_PRIMARY="anthropic/claude-opus-4.7"
AI_MODEL_FAST="anthropic/claude-haiku-4.5"

# ─── Redis (Upstash) — optional, gracefully degrades ─────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Cloudinary — optional (for persisting exported PDFs) ─
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Observability ───────────────────────────────────────
LOG_LEVEL="info"
