    "@editorjs/list": "^2.0.9",
    "@editorjs/paragraph": "^2.11.7",
    "@hookform/resolvers": "^5.2.2",
    "@langchain/anthropic": "^1.3.29",
    "@langchain/core": "^1.1.45",
